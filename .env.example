# =============================================================================
# Kanflow — FRONT (Vite). Copie para .env e ajuste.
# =============================================================================

# --- Rodar front + back no mesmo PC (recomendado em dev) ---
# Não defina VITE_API_URL: o front usa /api no próprio :5173 e o Vite encaminha para o Spring.
# Alvo do proxy (porta do seu Spring, ex. PORT=9090):
VITE_PROXY_TARGET=http://127.0.0.1:9090

# Opcional: chamar a API direto (precisa de CORS liberado no backend para http://localhost:5173)
# VITE_API_URL=http://127.0.0.1:9090

# Opcional: só quadro local, sem servidor (demo)
# VITE_DEMO_LOCAL=true
